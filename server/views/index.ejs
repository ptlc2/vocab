<%- include('partials/header', { title: 'Accueil', nav: 'home' }) %>
<section class="hero">
    <p class="eyebrow">Jeu lexical solo</p>
    <h1>Apprendre le vocabulaire,<br />avec justesse et nuance.</h1>
    <p class="lede">Devine le mot derrière sa définition, explore les nuances entre mots proches, et approprie-toi un lexique plus riche, définition par définition.</p>
    <div class="actions">
        <a class="btn btn-primary" href="<%= base %>/game">Jouer</a>
        <a class="btn btn-secondary" href="<%= base %>/words">Parcourir les mots</a>
    </div>
    <div class="mode-row">
        <span class="mode-label">Deux familles :</span>
        <a class="chip" href="<%= base %>/game?famille=acquisition">Acquisition lexicale</a>
        <a class="chip" href="<%= base %>/game?famille=distinction">Distinction sémantique</a>
    </div>
    <div class="mode-row forms-row">
        <span class="mode-label">Six formes :</span>
        <a class="chip" href="<%= base %>/game?mode=identification">Définition → mot</a>
        <a class="chip" href="<%= base %>/game?mode=reverse">Mot → définition</a>
        <a class="chip" href="<%= base %>/game?mode=frappe">Écrire le mot</a>
        <a class="chip" href="<%= base %>/game?mode=contexte">Le mot juste dans la phrase</a>
        <a class="chip" href="<%= base %>/game?mode=jumelage">Mot contre son confondu</a>
        <a class="chip" href="<%= base %>/game?mode=frappe-contexte">Écrire le mot juste (costaud)</a>
    </div>
    <div class="stat-row">
        <span class="stat"><b><%= stats.words %></b> mots</span>
        <span class="stat"><b><%= stats.categories %></b> catégories</span>
        <span class="stat"><b><%= stats.examples %></b> exemples</span>
        <span class="stat"><b><%= stats.confusions %></b> nuances</span>
    </div>
</section>
<%- include('partials/footer') %>
