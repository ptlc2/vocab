<%- include('partials/header', { title: 'Jeu', nav: 'game' }) %>
<form class="game-card" method="post" action="<%= base %>/game/answer">
    <p class="game-label">Quel est ce mot ?</p>
    <p class="game-definition"><%= game.definition %></p>
    <input type="hidden" name="target" value="<%= game.targetId %>" />
    <ul class="options">
        <%_ for (const option of game.options) { _%>
        <li><button class="option-btn" type="submit" name="choice" value="<%= option.id %>"><%= option.text %></button></li>
        <%_ } _%>
    </ul>
    <p class="game-hint">Une bonne réponse renforce le mot ; une erreur le fera revenir plus tard.</p>
</form>
<%- include('partials/footer') %>
