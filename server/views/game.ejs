<%- include('partials/header', { title: 'Jeu', nav: 'game' }) %>
<%_
    const MODE_BADGES = { acquisition: 'Acquisition lexicale', reverse: 'Acquisition inversée', distinction: 'Distinction sémantique', jumelage: 'Distinction sémantique' };
    const MODE_LABELS = {
        acquisition: 'Quel est ce mot ?',
        reverse: 'Quelle est sa définition ?',
        distinction: 'Le mot juste, c’est lequel ?',
        jumelage: 'Sa définition, c’est laquelle ?',
    };
    const MODE_HINTS = {
        acquisition: 'Une bonne réponse renforce le mot ; une erreur le fera revenir plus tard.',
        reverse: 'Quatre définitions — une seule est celle du mot.',
        distinction: 'Deux mots souvent confondus : le contexte tranche.',
        jumelage: 'Deux définitions, deux mots souvent confondus — la nuance tranche.',
    };
_%>
<form class="game-card" method="post" action="<%= base %>/game/answer">
    <p class="game-mode"><span><%= MODE_BADGES[game.mode] %></span></p>
    <p class="game-label"><%= MODE_LABELS[game.mode] %></p>
    <p class="game-definition"><%= game.definition %></p>
    <input type="hidden" name="target" value="<%= game.targetId %>" />
    <input type="hidden" name="mode" value="<%= game.mode %>" />
    <%_ if (sticky) { _%>
    <input type="hidden" name="sticky" value="1" />
    <%_ } _%>
    <%_ if (game.sentence) { _%>
    <input type="hidden" name="sentence" value="<%= game.sentence %>" />
    <%_ } _%>
    <%_ if (game.nuance) { _%>
    <input type="hidden" name="nuance" value="<%= game.nuance %>" />
    <%_ } _%>
    <%_ if (game.mode === 'jumelage' && game.otherId) { _%>
    <input type="hidden" name="other" value="<%= game.otherId %>" />
    <%_ } _%>
    <ul class="options">
        <%_ for (const option of game.options) { _%>
        <li>
            <button class="option-btn<%= game.mode === 'reverse' || game.mode === 'jumelage' ? ' option-def' : '' %>" type="submit" name="choice" value="<%= option.id %>">
                <%= option.text %>
            </button>
        </li>
        <%_ } _%>
    </ul>
    <p class="game-hint"><%= MODE_HINTS[game.mode] %></p>
</form>
<%- include('partials/footer') %>
