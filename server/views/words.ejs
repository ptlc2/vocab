<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="<%= base %>/style.css">
    <title>Tous les mots</title>
</head>
<body>
    <a href="<%= base %>/">Accueil</a>
    <h1>Tous les mots</h1>
    <ul>
    <%_ words.forEach(function(word) { _%>
        <li><a href="<%= base %>/words/<%= encodeURIComponent(word.text) %>"><%= word.text %></a></li>
    <%_ }); _%>
    </ul>
</body>
</html>