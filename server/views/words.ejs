<%- include('partials/header', { title: 'Les mots', nav: 'words' }) %>
<%_ const pageHref = (p) => {
    const params = new URLSearchParams();
    params.set('page', p);
    if (q) params.set('q', q);
    if (category) params.set('categorie', category);
    return `${base}/words?${params.toString()}`;
}; _%>
<div class="page-head">
    <%_ if (q) { _%>
    <h1>Recherche : « <%= q %> »</h1>
    <p class="page-sub"><%= total %> mot<%= total > 1 ? 's' : '' %> trouvé<%= total > 1 ? 's' : '' %>.</p>
    <%_ } else if (category) { _%>
    <h1>Catégorie : <%= category %></h1>
    <p class="page-sub"><%= total %> mot<%= total > 1 ? 's' : '' %> dans cette catégorie.</p>
    <%_ } else { _%>
    <h1>Les mots</h1>
    <p class="page-sub">Classés par niveau, du courant à l’érudit.</p>
    <%_ } _%>
    <%_ if (pageCount > 1) { _%>
    <p class="page-sub">Page <%= page %> sur <%= pageCount %>.</p>
    <%_ } _%>
</div>
<div class="filters">
    <form class="search-form" method="get" action="<%= base %>/words">
        <input type="search" name="q" value="<%= q %>" placeholder="Chercher un mot ou une définition…" aria-label="Chercher un mot" />
        <button type="submit" class="btn btn-secondary">Chercher</button>
        <%_ if (q || category) { _%>
        <a class="btn btn-secondary" href="<%= base %>/words">Effacer</a>
        <%_ } _%>
    </form>
    <div class="chips">
        <a class="chip <%_ if (!category && !q) { _%>active<%_ } _%>" href="<%= base %>/words">Tous</a>
        <%_ for (const cat of categories) { _%>
        <a class="chip <%_ if (category === cat.name) { _%>active<%_ } _%>" href="<%= base %>/words?categorie=<%= encodeURIComponent(cat.name) %>"
            ><%= cat.name %> <span class="count"><%= cat.word_count %></span></a>
        <%_ } _%>
    </div>
</div>
<%_ for (const group of groups) { _%>
<section class="level-group" style="--level: <%= group.color %>">
    <div class="level-head">
        <span class="level-dot" aria-hidden="true"></span>
        <h2 class="level-name"><%= group.name %></h2>
        <span class="level-count"><%= group.words.length %> mot<%= group.words.length > 1 ? 's' : '' %></span>
        <p class="level-desc"><%= group.description %></p>
    </div>
    <div class="word-grid">
        <%_ for (const word of group.words) { _%>
        <a class="word-card" href="<%= base %>/words/<%= encodeURIComponent(word.text) %>">
            <span class="word-text"><%= word.text %></span>
            <span class="badges"><span class="badge"><%= word.register %></span></span>
            <span class="word-def"><%= word.short_definition %></span>
        </a>
        <%_ } _%>
    </div>
</section>
<%_ } _%>
<%_ if (groups.length === 0) { _%>
<p class="page-sub">Aucun mot ne correspond. <a href="<%= base %>/words">Voir tous les mots</a>.</p>
<%_ } _%>
<%_ if (pageCount > 1) { _%>
<nav class="pagination" aria-label="Pages de mots">
    <%_ if (page > 1) { _%>
    <a class="page-arrow" href="<%= pageHref(page - 1) %>">Précédent</a>
    <%_ } else { _%>
    <span class="page-arrow" aria-hidden="true"></span>
    <%_ } _%>
    <%_ if (pageCount <= 8) { _%>
    <%_ for (let p = 1; p <= pageCount; p++) { _%>
    <%_ if (p === page) { _%>
    <span class="page-num active" aria-current="page"><%= p %></span>
    <%_ } else { _%>
    <a class="page-num" href="<%= pageHref(p) %>"><%= p %></a>
    <%_ } _%>
    <%_ } _%>
    <%_ } else { _%>
    <span class="page-num active" aria-current="page"><%= page %></span>
    <%_ } _%>
    <%_ if (page < pageCount) { _%>
    <a class="page-arrow" href="<%= pageHref(page + 1) %>">Suivant</a>
    <%_ } else { _%>
    <span class="page-arrow" aria-hidden="true"></span>
    <%_ } _%>
</nav>
<%_ } _%>
<%- include('partials/footer') %>
