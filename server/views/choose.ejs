<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Apprendre le vocabulaire par le jeu : définitions, nuances, mots proches et confusions classiques.">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23241f18'/%3E%3Ctext x='32' y='45' font-family='Georgia,serif' font-style='italic' font-size='38' fill='%23f3ead8' text-anchor='middle'%3EV%3C/text%3E%3C/svg%3E">
    <link rel="stylesheet" href="<%= base %>/style.css?v=4">
    <title>Vocab</title>
</head>
<body>
    <main class="choose-card">
        <p class="choose-brand">Vocab<span class="brand-dot">.</span></p>
        <p class="game-label">Choisis ta langue</p>
        <div class="choose-languages">
        <%_ for (const language of languages) { _%>
            <a class="choose-lang" href="<%= language.href %>"><%= language.name %></a>
        <%_ } _%>
        </div>
    </main>
</body>
</html>
