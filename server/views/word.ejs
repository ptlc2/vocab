<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="<%= base %>/style.css">
    <title><%= word.text %></title>
</head>
<body>
    <a href="<%= base %>/">Accueil</a>
    <h1><%= word.text %></h1>
    <%_ difficulty = difficulties[word.difficulty]; _%>
    <p><b>Difficulté :</b> <span title="<%= difficulty.description %>" style="color: <%= difficulty.color %>;"><%= difficulty.name %></span></p>
    <p><b>Registre :</b> <%= word.register %></p>
    <p><b>Définition courte :</b> <%= word.short_definition %></p>
    <p><b>Définition longue :</b> <%= word.long_definition %></p>
<%_ if (word.origin) { _%>
    <p><b>Origine :</b> <%= word.origin %></p>
<%_ } _%>
<%_ if (word.notes) { _%>
    <p><b>Notes :</b> <%= word.notes %></p>
<%_ } _%>
    <p><b>Création :</b> <time datetime="<%= word.created_at.toISOString() %>"><%= word.created_at.toLocaleString(locale) %></time></p>
    <p><b>Modification :</b> <time datetime="<%= word.updated_at.toISOString() %>"><%= word.updated_at.toLocaleString(locale) %></time></p>
    <p><b>Catégories :</b></p>
    <ul>
    <%_ word.categories.forEach(category => { _%>
        <li><%= category.name %></li>
    <%_ }); _%>
    </ul>
    <p><b>Exemples :</b></p>
    <ul>
    <%_ word.examples.forEach(example => { _%>
        <li><%= example.sentence %></li>
    <%_ }); _%>
    </ul>
    <p><b>Mots proches :</b></p>
    <ul>
    <%_ word.near_words.forEach(nearWord => { _%>
        <li><a href="<%= base %>/words/<%= encodeURIComponent(nearWord.text) %>"><%= nearWord.text %></a></li>
    <%_ }); _%>
    </ul>
    <p><b>Mots confondables :</b></p>
    <ul>
    <%_ word.confusions.forEach(confusion => { _%>
        <li><a href="<%= base %>/words/<%= encodeURIComponent(confusion.text) %>"><%= confusion.text %></a> (<%= confusion.nuance %>)</li>
    <%_ }); _%>
    </ul>
</body>
</html>