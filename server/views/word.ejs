<%- include('partials/header', { title: word.text, nav: 'words' }) %>
<%_ const difficulty = difficulties[word.difficulty]; _%>
<article class="entry">
    <header class="entry-head">
        <h1><%= word.text %></h1>
        <div class="badges">
            <span class="badge" style="--level: <%= difficulty.color %>" title="<%= difficulty.description %>">
                <span class="badge-dot" aria-hidden="true"></span> <%= difficulty.name %>
            </span>
            <span class="badge"><%= word.register %></span>
            <%_ for (const category of word.categories) { _%>
            <a class="badge" href="<%= base %>/words?categorie=<%= encodeURIComponent(category.name) %>"><%= category.name %></a>
            <%_ } _%>
        </div>
    </header>

    <p class="short-def"><%= word.short_definition %></p>
    <p class="long-def"><%= word.long_definition %></p>

    <%_ if (word.origin) { _%>
    <section class="entry-section">
        <h2>Origine</h2>
        <p class="origin-text"><%= word.origin %></p>
    </section>
    <%_ } _%>

    <%_ if (word.examples.length > 0) { _%>
    <section class="entry-section">
        <h2>En usage</h2>
        <ul class="examples">
            <%_ for (const example of word.examples) { _%>
            <li><%= example.sentence %></li>
            <%_ } _%>
        </ul>
    </section>
    <%_ } _%>

    <%_ if (word.confusions.length > 0) { _%>
    <section class="entry-section">
        <h2>Ne pas confondre avec</h2>
        <div class="confusion-list">
            <%_ for (const confusion of word.confusions) { _%>
            <div class="confusion-card">
                <a class="confusion-word" href="<%= base %>/words/<%= encodeURIComponent(confusion.text) %>"><%= confusion.text %></a>
                <p><%= confusion.nuance %></p>
            </div>
            <%_ } _%>
        </div>
    </section>
    <%_ } _%>

    <%_ if (word.near_words.length > 0) { _%>
    <section class="entry-section">
        <h2>Mots proches</h2>
        <div class="chips">
            <%_ for (const nearWord of word.near_words) { _%>
            <a class="chip" href="<%= base %>/words/<%= encodeURIComponent(nearWord.text) %>"><%= nearWord.text %></a>
            <%_ } _%>
        </div>
    </section>
    <%_ } _%>

    <div class="entry-actions">
        <a class="btn btn-primary" href="<%= base %>/game">Jouer</a>
        <a class="btn btn-secondary" href="<%= base %>/words">Tous les mots</a>
    </div>
</article>
<%- include('partials/footer') %>
